{
  "name": "jawab-do",
  "version": "1.0.0",
  "description": "Supply Setu: an open, shared supply-chain record for India's essential goods on Arkiv, the Web3 database (Tiramisu testnet), checked against official government prices.",
  "main": "index.js",
  "scripts": {
    "test": "node --import tsx --test --env-file-if-exists=.env tests/setu.test.ts",
    "dev": "vite",
    "build": "vite build",
    "start": "tsx --env-file-if-exists=.env server/main.ts",
    "typecheck": "tsc -p .",
    "seed": "tsx --env-file=.env scripts/seed-setu.ts",
    "ingest": "tsx --env-file=.env scripts/ingest-prices.ts",
    "verify": "tsx --env-file-if-exists=.env scripts/verify.ts",
    "probe": "tsx --env-file=.env scripts/probe-write.ts"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "private": "true",
  "dependencies": {
    "@arkiv-network/sdk": "0.8.1",
    "viem": "2.57.3"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  },
  "engines": {
    "node": ">=22.20.0 <23"
  }
}
