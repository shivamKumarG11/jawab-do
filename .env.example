# Jawab Do environment variables (copy to .env or generate fresh keys with: npx tsx scripts/gen-wallets.ts)
# Never commit real keys.

# Arkiv Hub access key for Tiramisu (https://hub.arkiv.network/api-keys) — raises server-side read limits
ARKIV_ACCESS_KEY=

# Testnet-only relay wallet private keys (0x... 32-byte hex). Fund on Tiramisu at https://hub.arkiv.network/faucet
DESK_KEY=
LEGAL_AID_KEY=
SPOOFER_KEY=

# Optional public address overrides (defaults to addresses derived from DESK_KEY and LEGAL_AID_KEY)
# DESK_ADDRESS=0x849C3840754cf21B0ec45BA359cCcde1F8ECEBd2
# LEGAL_AID_ADDRESS=0xb114Ab157311e6C15B74fb08789632671d45D9c2

# Optional daily write cap for the public demo relay (default: 300)
GLOBAL_WRITES_PER_DAY=300
