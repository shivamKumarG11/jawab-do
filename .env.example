# Supply Setu environment (copy to .env). Never commit real keys.
# Generate role wallets: npx tsx scripts/gen-wallets.ts, then fund each on Tiramisu at https://hub.arkiv.network/faucet

# Arkiv Hub access key for Tiramisu (https://hub.arkiv.network/api-keys): raises server-side read limits
ARKIV_ACCESS_KEY=

# Testnet-only role wallets (0x… 32-byte hex private keys)
ORACLE_KEY=
REGULATOR_KEY=
MAKER_FOOD_KEY=
MAKER_PHARMA_KEY=
DISTRIBUTOR_KEY=
RETAILER_KEY=
SPOOFER_KEY=

# Optional: data.gov.in API key for live Agmarknet mandi prices (https://data.gov.in, My Account → API key)
DATA_GOV_IN_KEY=

# Optional: token for POST /api/admin/ingest (force a price refresh)
ADMIN_TOKEN=

# Optional daily write cap for the public demo relay (default 400)
GLOBAL_WRITES_PER_DAY=400
